# --- Database -------------------------------------------------------------
# Local SQLite file (created by `npm run setup`). For production you can use
# a hosted libSQL/Turso database: DATABASE_URL="libsql://your-db.turso.io"
DATABASE_URL="file:./data/hrsat.db"
DATABASE_AUTH_TOKEN=""

# --- Auth -----------------------------------------------------------------
# Long random string used to sign dashboard sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account, created by `npm run setup`
ADMIN_NAME="HRSAT Admin"
ADMIN_EMAIL="admin@hrsat.org"
ADMIN_PASSWORD="ChangeMe!2026"

# --- Email (SMTP) -----------------------------------------------------------
# Works with Gmail (App Password), Outlook, Zoho, SendGrid, Brevo, etc.
# If SMTP_HOST is empty, emails are printed to the terminal instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HRSAT Secure Reporting <no-reply@hrsat.org>"
# Where new-report alerts for the team are sent
TEAM_INBOX="info@hrsat.org"

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "true" after running `npm run images:download` to serve images locally
NEXT_PUBLIC_LOCAL_IMAGES="true"
